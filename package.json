{
  "name": "lazuli-arcade",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "description": "Arcade de jogos casuais para o celular: Lazuli Blocks, Empilha e Puga Salta.",
  "author": {
    "name": "Renan Augusto dos Santos",
    "url": "https://renanaugusto.com.br"
  },
  "license": "UNLICENSED",
  "homepage": "https://renanfrontend.github.io/lazuli-arcade/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renanfrontend/lazuli-arcade.git"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:artifact": "tsc -b && vite build --mode artifact && node scripts/to-artifact.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.3.0",
    "@fontsource/lilita-one": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3"
  }
}
